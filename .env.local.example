# ─────────────────────────────────────────────────────────────────
# HPD FunWeez — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Google Sheets Integration ─────────────────────────────────
# Get these from your Service Account JSON key file.
# Step-by-step: See DEPLOYMENT.md → Section "Google Sheets Setup"

# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/[THIS_PART]/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1aGnmyBcpG529VOQzYdTNCfLpF0C9Vo_tir4mvPES354

# Service account email (from the JSON key — "client_email" field)
GOOGLE_SERVICE_ACCOUNT_EMAIL=funweez@your-project.iam.gserviceaccount.com

# Private key (from the JSON key — "private_key" field)
# IMPORTANT: Keep the \n line breaks as-is — do NOT expand them
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour key here...\n-----END RSA PRIVATE KEY-----\n"

# ── App Config (optional) ─────────────────────────────────────
# Leave blank to use defaults defined in code
# NEXT_PUBLIC_APP_NAME=HPD FunWeez
